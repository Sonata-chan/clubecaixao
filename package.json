{
    "name": "rmmz-game",
    "private": true,
    "main": "index.html",
    "scripts": {
        "test:e2e:stop-server": "sh -c 'pid=$(lsof -tiTCP:8000 -sTCP:LISTEN || true); if [ -n \"$pid\" ]; then kill $pid; fi'",
        "test:e2e": "npm run test:e2e:stop-server && playwright test",
        "test:e2e:headed": "npm run test:e2e:stop-server && playwright test --headed",
        "test:e2e:debug": "npm run test:e2e:stop-server && playwright test --debug",
        "test:e2e:full-route": "npm run test:e2e:stop-server && playwright test tests/e2e/full-route-media.spec.js --reporter=line"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0"
    },
    "chromium-args": "--force-color-profile=srgb",
    "window": {
        "title": "clubecaixao",
        "width": 816,
        "height": 624,
        "position": "center",
        "icon": "icon/icon.png"
    }
}